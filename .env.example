# Copy to .env.local for local work. Never commit .env.local.
# The engine preview needs none of these. They are for build steps 5 onward (specs/10-build-plan.md).

# Supabase: the Vercel Marketplace integration adds its own variables for the URL, the public key
# and the secret key. Pull them locally with `vercel env pull .env.local`.

# Anthropic. Server only. Set a monthly spend limit on the key.
ANTHROPIC_API_KEY=
# Model names. Check Anthropic's documentation for the current ones.
CLAUDE_MODEL_FAST=
CLAUDE_MODEL_SMART=

# Demo accounts created by the seed script. Choose your own values.
DEMO_LENDER_PASSWORD=
DEMO_INSURER_PASSWORD=
DEMO_OPS_PASSWORD=

# The second Supabase project, used only by the automated tests.
TEST_SUPABASE_URL=
TEST_SUPABASE_SECRET_KEY=
# Its publishable key (Settings > API Keys). The access tests sign in with it, as a browser would.
TEST_SUPABASE_PUBLISHABLE_KEY=
# Its database connection string, Session pooler (the Connect button), with the database password filled in.
# Only `npm run db:migrate`, `npm run db:seed` and the database tests use it.
TEST_SUPABASE_DB_URL=

# Signs the customer phone mock's case links. Server only. Any long random value.
CUSTOMER_LINK_SECRET=

# Optional: Razorpay test mode. Test keys only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
